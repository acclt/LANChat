<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="54dp" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal">
        <ImageView android:id="@+id/sync_icon" android:layout_width="28dp" android:layout_height="28dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/sync_app" android:layout_width="match_parent" android:layout_height="20dp"
            android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/sync_title" android:layout_width="match_parent" android:layout_height="17dp"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:textSize="13sp" />
        <TextView android:id="@+id/sync_text" android:layout_width="match_parent" android:layout_height="17dp"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Compat.Notification" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="14dp" android:orientation="horizontal">
            <TextView android:id="@+id/sync_source" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" android:textSize="10sp" />
            <TextView android:id="@+id/sync_time" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_marginStart="8dp" android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
